---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "spoiler-tag relative mx-0.5 inline-block cursor-pointer rounded px-1 py-0.5 align-baseline transition-all duration-300 select-none",
    className,
  ]}
  role="button"
  tabindex="0"
  aria-expanded="false"
>
  <!-- subtle etched glass background tone -->
  <span
    class="spoiler-glass pointer-events-none absolute inset-0 rounded transition-opacity duration-300"
  ></span>

  <!-- text: softly frosted silhouette -->
  <span class="spoiler-text font-inherit transition-all duration-300">
    <slot />
  </span>
</span>

<style>
  .spoiler-tag {
    vertical-align: -0.1em;
  }

  /* etched, matte glass surface (dark mode) */
  .spoiler-glass {
    background-color: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* text silhouette: clearly text, but safely blurred */
  .spoiler-text {
    filter: blur(3.5px);
    opacity: 0.38;
    user-select: none;
    -webkit-user-select: none;
    color: currentColor;
    pointer-events: none;
  }

  /* etched surface (light mode) */
  :global(:root:not([data-theme="dark"])) .spoiler-glass {
    background-color: rgba(0, 0, 0, 0.04);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }

  :global(:root:not([data-theme="dark"])) .spoiler-text {
    opacity: 0.32;
  }

  /* ================= revealed ================= */
  .spoiler-tag:hover,
  .spoiler-tag:focus-visible,
  .spoiler-tag[data-revealed="true"] {
    cursor: text;
  }

  .spoiler-tag:hover .spoiler-glass,
  .spoiler-tag:focus-visible .spoiler-glass,
  .spoiler-tag[data-revealed="true"] .spoiler-glass {
    opacity: 0;
  }

  .spoiler-tag:hover .spoiler-text,
  .spoiler-tag:focus-visible .spoiler-text,
  .spoiler-tag[data-revealed="true"] .spoiler-text {
    filter: blur(0);
    opacity: 1;
    user-select: text;
    -webkit-user-select: text;
    pointer-events: auto;
  }

  /* discreet outline for keyboard tab navigation */
  .spoiler-tag:focus-visible {
    outline: 1px dashed rgba(255, 255, 255, 0.3);
    outline-offset: 1px;
  }
</style>

<script>
  function initSpoilers() {
    document.querySelectorAll<HTMLElement>(".spoiler-tag").forEach(el => {
      const toggle = () => {
        const isRevealed = el.getAttribute("data-revealed") === "true";
        el.setAttribute("data-revealed", (!isRevealed).toString());
        el.setAttribute("aria-expanded", (!isRevealed).toString());
      };

      el.addEventListener("click", toggle);
      el.addEventListener("keydown", e => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });
  }

  initSpoilers();
  document.addEventListener("astro:page-load", initSpoilers);
</script>
